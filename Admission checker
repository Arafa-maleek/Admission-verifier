def export_to_pdf():
    global user
    if not user:
        print("Register first")
        return
    name = input("Save report as: ")
    filename = f"{name}.pdf"
    c = canvas.Canvas(filename, pagesize=A4)
    width, height = A4
    c.setFont("Helvetica-Bold", 14)
    c.drawString(100, height - 50, "Student Admission Report")
    c.setFont("Helvetica", 10)

    y = height - 100
    c.drawString(50, y, f"Name: {asn} {afn}")
    y -= 20
    c.drawString(50, y, f"Year of Birth: {ay}")
    y -= 20
    c.drawString(50, y, f"University: {au}")
    y -= 20
    c.drawString(50, y, f"Field: {af}")
    y -= 20
    c.drawString(50, y, f"Course: {ac}")
    y -= 20
    c.drawString(50, y, f"UTME Score: {aut}")
    y -= 20
    c.drawString(50, y, f"Post-UTME Score: {emark}")
    y -= 20
    c.drawString(50, y, f"Admission Status: {vvf}")

    c.save()
    print("Export successful")
    print("Report saved as",filename,"")

    
